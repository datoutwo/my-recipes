---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from './RecipeCard.astro';
import CategoryNavigation from './CategoryNavigation.astro';
import { categories } from '../data/categories';
import { localePath } from '../data/urls';
import { languages, localeCategory, ui, type Language } from '../data/locales';
interface Props { lang: Language; categorySlug: string }
const { lang, categorySlug } = Astro.props;
const category = categories.find((item) => item.slug === categorySlug);
if (!category) throw new Error(`Unknown category: ${categorySlug}`);
const text = ui[lang];
const allRecipes = await getCollection('recipes', ({ data }) => data.language === lang);
const filtered = allRecipes.filter((recipe) => recipe.data.category === category.name);
const counts = Object.fromEntries(categories.map(({ name }) => [name, name === 'All recipes' ? allRecipes.length : allRecipes.filter((recipe) => recipe.data.category === name).length]));
const switchLinks = Object.fromEntries(languages.map(({ code }) => [code, localePath(code, `categories/${category.slug}/`)]));
---
<BaseLayout title={localeCategory(lang, category.name)} lang={lang} switchLinks={switchLinks}>
	<div class="category-page"><aside><p class="side-title">{text.browse}</p><CategoryNavigation active={category.name} counts={counts} lang={lang} /></aside><section><a class="back" href={`${localePath(lang)}#recipes`}>{text.back}</a><p class="eyebrow">{text.collection}</p><h1>{localeCategory(lang, category.name)}</h1><p class="intro">{text.categoryIntro.replace('{category}', localeCategory(lang, category.name).toLowerCase())}</p><div class="grid">{filtered.length ? filtered.map((recipe) => <RecipeCard recipe={recipe} lang={lang} />) : <p class="empty">{text.empty}</p>}</div></section></div>
</BaseLayout>
<style>
	.category-page{max-width:1136px;margin:48px auto;padding:0 32px;display:grid;grid-template-columns:205px 1fr;gap:45px}.side-title{margin:0 0 13px 12px;color:#989b91;font-size:9px;font-weight:700;letter-spacing:1.7px}.back{display:inline-block;margin-bottom:25px;color:#788074;font-size:12px}.eyebrow{margin:0;color:#798574;font-size:9px;font-weight:700;letter-spacing:2px}.category-page h1{margin:7px 0;font:600 39px 'Playfair Display',serif}.intro{margin:0 0 24px;color:#82877d;font-size:13px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}.empty{padding:30px;color:#82877d}@media(max-width:900px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.category-page{gap:25px;grid-template-columns:170px 1fr}}@media(max-width:650px){.category-page{display:block;margin:30px auto;padding:0 20px}.category-page aside{margin-bottom:26px}.category-page aside :global(.category-list){grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}}
</style>
