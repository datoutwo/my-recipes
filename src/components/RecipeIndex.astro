---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from './RecipeCard.astro';
import CategoryNavigation from './CategoryNavigation.astro';
import { categories } from '../data/categories';
import { localePath } from '../data/urls';
import { localeCategory, ui, type Language } from '../data/locales';
interface Props { lang?: Language }
const { lang = 'zh-TW' } = Astro.props;
const text = ui[lang];
const recipes = (await getCollection('recipes', ({ data }) => data.language === lang)).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
const counts = Object.fromEntries(categories.map(({ name }) => [name, name === 'All recipes' ? recipes.length : recipes.filter((recipe) => recipe.data.category === name).length]));
const searchableRecipes = recipes.map(({ id, data }) => ({ id, title: data.title, description: data.description, image: data.image, category: localeCategory(lang, data.category), prepTime: data.prepTime, cookTime: data.cookTime, tags: data.tags, ingredients: data.ingredients }));
---
<BaseLayout lang={lang}>
	<section class="welcome" id="top"><span class="eyebrow"><span></span> {text.homeEyebrow}</span><h1>{text.headlineA}<br /><em>{text.headlineB}</em></h1><p>{text.welcome}</p><a class="explore" href="#recipes">{text.explore} <span>↓</span></a><div class="welcome-mark" aria-hidden="true">✳</div></section>
	<div class="content-wrap" id="recipes"><aside class="sidebar" id="categories"><div class="side-title">{text.browse}</div><CategoryNavigation counts={counts} lang={lang} /><div class="side-note" id="about"><span>✦</span><p>{text.sideNote}</p></div></aside>
		<section class="listing"><div class="listing-head"><div><span class="eyebrow">{text.fromKitchen}</span><h2>{text.allRecipes} <span class="total">{recipes.length}</span></h2></div><label class="search"><span>⌕</span><input id="recipe-search" type="search" placeholder={text.search} aria-label={text.searchLabel} /><kbd>⌘ K</kbd></label></div><div class="chips" aria-label={text.browse}>{categories.filter((category) => category.slug !== 'all').map((category) => <a href={localePath(lang, `categories/${category.slug}/`)}>{category.icon} {localeCategory(lang, category.name)}</a>)}</div><div class="recipe-grid" id="recipe-grid">{recipes.map((recipe) => <RecipeCard recipe={recipe} lang={lang} />)}</div><div class="no-results" id="no-results" hidden>{text.empty}</div></section>
	</div>
	<script id="recipe-data" type="application/json" set:html={JSON.stringify(searchableRecipes).replaceAll('<', '\\u003c')} />
	<script>
		const input = document.querySelector<HTMLInputElement>('#recipe-search')!;
		const grid = document.querySelector<HTMLElement>('#recipe-grid')!;
		const empty = document.querySelector<HTMLElement>('#no-results')!;
		const cards = [...grid.children] as HTMLElement[];
		const searchData = JSON.parse(document.querySelector('#recipe-data')!.textContent ?? '[]') as { title: string; description: string; category: string; tags: string[]; ingredients: string[] }[];
		input.addEventListener('input', () => {
			const query = input.value.trim().toLocaleLowerCase();
			let visible = 0;
			cards.forEach((card, index) => {
				const recipe = searchData[index];
				const haystack = [recipe.title, recipe.description, recipe.category, ...recipe.tags, ...recipe.ingredients].join(' ').toLocaleLowerCase();
				const matches = haystack.includes(query);
				card.hidden = !matches;
				if (matches) visible++;
			});
			empty.hidden = visible > 0;
		});
		document.addEventListener('keydown', (event) => {
			if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); input.focus(); }
			if (event.key === 'Escape' && document.activeElement === input) { input.value = ''; input.dispatchEvent(new Event('input')); input.blur(); }
		});
	</script>
</BaseLayout>
<style>
	.welcome{max-width:1200px;height:310px;margin:auto;padding:45px 48px;position:relative;overflow:hidden;background:#f0f1e9}.eyebrow{color:#798574;font-size:9px;font-weight:700;letter-spacing:2px}.welcome .eyebrow{display:flex;align-items:center;gap:9px}.welcome .eyebrow span{width:7px;height:7px;border-radius:50%;background:#91a27e}.welcome h1{position:relative;z-index:1;margin:19px 0 11px;font:500 46px/1.08 'Playfair Display',serif;letter-spacing:-1.3px;color:#28352d}.welcome h1 em{color:#7b906d;font-weight:500}.welcome p{position:relative;z-index:1;margin:0;color:#7c8278;font-size:12px;line-height:1.7}.explore{position:relative;z-index:1;display:inline-flex;align-items:center;gap:15px;margin-top:18px;padding:10px 14px;border-radius:5px;background:#596f52;color:white;font-size:11px}.explore span{font-size:16px}.welcome-mark{position:absolute;right:12%;top:-100px;color:#e1e5d8;font-size:370px;line-height:1}.content-wrap{max-width:1200px;margin:44px auto 0;padding:0 32px;display:grid;grid-template-columns:205px 1fr;gap:42px}.sidebar{padding-top:4px}.side-title{margin:0 0 13px 12px;color:#989b91;font-size:9px;font-weight:700;letter-spacing:1.7px}.side-note{margin-top:38px;padding:15px 13px;display:flex;gap:9px;border:1px solid #e9e9df;border-radius:8px;color:#859176}.side-note span{font-size:12px}.side-note p{margin:0;color:#85897f;font:italic 12px/1.6 'Playfair Display',serif}.listing-head{display:flex;align-items:end;justify-content:space-between;gap:20px}.listing-head .eyebrow{font-size:9px}.listing-head h2{margin:7px 0 0;font:600 27px 'Playfair Display',serif}.total{display:inline-grid;place-items:center;vertical-align:middle;width:22px;height:22px;margin-left:5px;border-radius:50%;background:#eeefe9;color:#7b8275;font:500 10px 'DM Sans',sans-serif}.search{width:255px;height:37px;padding:0 10px;display:flex;align-items:center;gap:8px;border:1px solid #e9e7df;border-radius:6px;background:#fff;color:#91958b}.search>span{font-size:21px}.search input{min-width:0;flex:1;border:0;outline:0;font:11px 'DM Sans',sans-serif;color:#364237}.search kbd{padding:3px 5px;border:1px solid #eeece5;border-radius:3px;color:#9a9e94;font:9px 'DM Sans',sans-serif}.chips{display:flex;gap:7px;flex-wrap:wrap;margin:20px 0}.chips a{padding:7px 10px;border:1px solid #e9e7df;border-radius:20px;color:#737a70;background:#fff;font-size:10px}.chips a:hover{border-color:#cdd6c6;color:#526b50}.recipe-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}.no-results{padding:35px 10px;text-align:center;color:#82877d;font-size:13px}.no-results[hidden],.recipe-grid [hidden]{display:none!important}@media(max-width:920px){.content-wrap{grid-template-columns:170px 1fr;gap:25px}.recipe-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.welcome{height:290px}}@media(max-width:650px){.welcome{height:300px;padding:36px 24px}.welcome h1{font-size:39px}.welcome-mark{right:-40px;top:-55px;font-size:280px}.content-wrap{display:block;margin-top:28px;padding:0 20px}.sidebar{margin-bottom:27px}.sidebar .category-list{grid-template-columns:repeat(2,minmax(0,1fr))}.side-note{display:none}.listing-head{align-items:start;flex-direction:column}.search{width:100%}.recipe-grid{grid-template-columns:1fr 1fr;gap:10px}.image-link{height:145px}.card-copy{padding:12px}.card h3{font-size:16px}.card p{font-size:10px}.desktop{display:none}.chips{margin:14px 0}}
</style>
